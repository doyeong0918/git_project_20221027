<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="20dp"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="left"
            android:text="ButtonEvent 실습"
            android:textColor="#8BC34A"
            android:textSize="25sp"
            android:textStyle="bold|italic" />
    </LinearLayout>

    <!-- 물음표 등딱지를 달고 있는 달팽이 (버튼을 누르면 누른 등딱지가 들어간 그림으로 바뀜) -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="350dp"
        android:contentDescription="달팽이"
        android:scaleType="fitCenter"
        android:src="@drawable/snail_body" />

    <!-- 1 2 3 4 등딱지 버튼 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button1"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="1번"
            android:scaleType="fitCenter"
            android:src="@drawable/snail_shell_1" />

        <ImageButton
            android:id="@+id/button2"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="2번"
            android:scaleType="fitCenter"
            android:src="@drawable/snail_shell_2" />

        <ImageButton
            android:id="@+id/button3"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="3번"
            android:scaleType="fitCenter"
            android:src="@drawable/snail_shell_3" />

        <ImageButton
            android:id="@+id/button4"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="4번"
            android:scaleType="fitCenter"
            android:src="@drawable/snail_shell_4" />
    </LinearLayout>

    <!-- 정답입니다 / 틀렸습니다 (처음에는 비어 있음) -->
    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#000000"
        android:textSize="22sp" />

</LinearLayout>
